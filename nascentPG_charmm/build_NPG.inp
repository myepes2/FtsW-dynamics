* Generate Nascent PG
*

! --- Topology/parameters ---
stream toppar.str

! --- Initialize important variables --- 
stream pg_vars.str

! --- Build segments from sequences
stream @SEQFILENAME

! --- Apply all necessary patches
stream @PATCHFILENAME

! --- Angles/dihedrals after all patches ---
autogen angles dihe

! --- Seed segid GLY resid 2 from template PDB (optional) ---
!open read unit 10 card name custom_files/anam.pdb
!read coor pdb unit 10 resid sele segid GLY .and. resid 2 end
! open read unit 10 card name custom_files/l2_memb.pdb
! read coor pdb unit 10 resid sele segid GLY .or. segid PA01 end
open read unit 10 card name @PDBFILENAME
read coor pdb unit 10 resid sele segid G* .or. segid P* end
close unit 10

! --- Build missing coords ---
ic param
ic fill preserve
ic build
hbuild

!! --- Quick sanity energy before NBONDS (optional) ---
!energy

! --- Nonbond options (CDIE, high dielectric) ---
!bonds atom switch cdie vdw vfswitch  -
!      ctonnb 10.0 ctofnb 12.0 cutnb 14.0 cutim 14.0  -
!       inbfrq -1 imgfrq -1 wmin 1.0 eps 80.0

! --- Quick minimization ---
!calc nstep = 500
!mini sd   nstep @nstep nprint 10
!mini abnr nstep @nstep nprint 10

! --- Write outputs ---
open write unit 41 card name @EXPORTDIR/@EXPORTFN.psf
write psf  card unit 41
close unit 41

open write unit 42 card name @EXPORTDIR/@EXPORTFN.crd
write coor card unit 42
close unit 42

open write unit 43 card name @EXPORTDIR/@EXPORTFN.pdb
write coor pdb unit 43
close unit 43

bomlev -1

coor orient
coor stat sele all end

! Molecular Volume
calc dcel = 0.5
calc xdim = int ( ( ?xmax - ?xmin + 5.0 ) / @dcel ) + 1
calc ydim = int ( ( ?ymax - ?ymin + 5.0 ) / @dcel ) + 1
calc zdim = int ( ( ?zmax - ?zmin + 5.0 ) / @dcel ) + 1
calc space = @xdim * @ydim * @zdim

! prevent overflow on integer conversion
calc maxint = 2**32 / 2 - 1
if space .gt. @maxint calc space = @maxint

scalar wmain = radius
scalar wmain add 1.4    ! use solvent accessible surface for molecular volume
scalar 1 = wmain 
scalar 2 set 6
coor volume hole space @space sele .not. resname TIP3 end
set molvol = ?volume

calc cgtot = int ( ?cgtot )

open write unit 90 card name @EXPORTDIR/@EXPORTFN.str
write title unit 90
* set ncharge = @cgtot
* set xmax = ?xmax
* set ymax = ?ymax
* set zmax = ?zmax
* set xmin = ?xmin
* set ymin = ?ymin
* set zmin = ?zmin
* set molvol = @molvol
*

stop


